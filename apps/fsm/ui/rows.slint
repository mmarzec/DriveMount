// One line of the list: a profile, or an entry of the file that cannot be read (spec 7.1). Rust
// decides what each shows: see `fsm_app::ui::list`. A click opens the connection page; the details a
// row has no room for are on that page and in a tooltip.

import { Theme, Icons, Icon, AppButton } from "theme.slint";

export enum EntryKind { profile, unreadable }
export enum RowStatus { disconnected, connecting, mounted, unmounting, error }
export enum PrimaryAction { none, mount, cancel, unmount, retry }

export struct ListEntry {
    kind: EntryKind,
    top: length,
    height: length,
    name: string,
    address: string,
    letter: string,
    letter-is-live: bool,
    status: RowStatus,
    line: string,
    line-is-problem: bool,
    primary: PrimaryAction,
    primary-enabled: bool,
    can-open: bool,
    can-edit: bool,
    can-delete: bool,
}

// What each state is called, and what its button says.
export global RowTexts {
    public pure function status(kind: EntryKind, status: RowStatus) -> string {
        return kind == EntryKind.unreadable ? @tr("cannot be read")
            : status == RowStatus.mounted ? @tr("mounted")
            : status == RowStatus.connecting ? @tr("connecting")
            : status == RowStatus.unmounting ? @tr("unmounting")
            : status == RowStatus.error ? @tr("failed")
            : @tr("not mounted");
    }
    public pure function primary(action: PrimaryAction) -> string {
        return action == PrimaryAction.mount ? @tr("Mount")
            : action == PrimaryAction.cancel ? @tr("Cancel")
            : action == PrimaryAction.unmount ? @tr("Unmount")
            : action == PrimaryAction.retry ? @tr("Retry")
            : "";
    }
}

// The state as an icon. Only a connecting one asks for frames.
export component StatusIcon {
    in property <RowStatus> status;
    in property <EntryKind> kind: EntryKind.profile;
    in property <length> size: 20px;

    property <bool> busy: root.status == RowStatus.connecting || root.status == RowStatus.unmounting;

    width: root.size;
    height: root.size;
    accessible-role: none;

    Icon {
        size: root.size;
        source: root.kind == EntryKind.unreadable ? Icons.triangle-alert
            : root.status == RowStatus.mounted ? Icons.circle-check
            : root.status == RowStatus.error ? Icons.circle-alert
            : root.busy ? Icons.loader
            : Icons.circle;
        colour: root.kind == EntryKind.unreadable ? Theme.red
            : root.status == RowStatus.mounted ? Theme.green
            : root.status == RowStatus.error ? Theme.red
            : root.busy ? Theme.amber
            : Theme.grey;
        opacity: root.status == RowStatus.connecting ? 0.6 + 0.4 * Math.sin(360deg * animation-tick() / 1.2s) : 1;
    }
}

export component ProfileRow {
    in property <ListEntry> entry;
    in property <bool> selected;
    in property <bool> interactive: true;
    in property <int> position;
    in property <int> total;

    callback pressed();
    callback primary();
    callback open();
    callback edit();
    callback delete();
    callback hover-changed(hovering: bool);

    property <string> status-text: RowTexts.status(entry.kind, entry.status);
    property <string> primary-text: RowTexts.primary(entry.primary);

    accessible-role: list-item;
    accessible-label: entry.name + ", " + status-text
        + (entry.address != "" ? ", " + entry.address : "")
        + (entry.letter != "" ? ", " + entry.letter : "")
        + (entry.line != "" ? ", " + entry.line : "");
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-item-index: position;
    accessible-item-count: total;
    accessible-action-default => {
        root.pressed();
    }

    menu := ContextMenuArea {
        enabled: root.interactive;
        Menu {
            MenuItem {
                title: @tr("Details");
                activated => {
                    root.pressed();
                }
            }
            if root.entry.can-open: MenuItem {
                title: @tr("Open in Explorer");
                activated => {
                    root.open();
                }
            }
            MenuItem {
                title: @tr("Edit…");
                enabled: root.entry.can-edit;
                activated => {
                    root.edit();
                }
            }
            MenuItem {
                title: @tr("Delete…");
                enabled: root.entry.can-delete;
                activated => {
                    root.delete();
                }
            }
        }

        Rectangle {
            border-radius: Theme.radius;
            background: root.selected ? Theme.selected
                : touch.has-hover ? Theme.hover
                : transparent;
        }

        touch := TouchArea {
            enabled: root.interactive;
            mouse-cursor: pointer;
            clicked => {
                root.pressed();
            }
            changed has-hover => {
                root.hover-changed(self.has-hover);
            }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                StatusIcon {
                    status: root.entry.status;
                    kind: root.entry.kind;
                }
            }

            Text {
                text: root.entry.name;
                preferred-width: 0;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
                color: Theme.text;
                accessible-role: none;
            }

            VerticalLayout {
                alignment: center;
                width: 96px;

                if root.entry.primary != PrimaryAction.none: AppButton {
                    text: root.primary-text;
                    primary: root.entry.primary == PrimaryAction.retry;
                    enabled: root.interactive && root.entry.primary-enabled;
                    accessible-label: root.primary-text + " " + root.entry.name;
                    clicked => {
                        root.primary();
                    }
                }
            }

            Text {
                text: root.entry.letter;
                width: 28px;
                vertical-alignment: center;
                horizontal-alignment: right;
                font-weight: 600;
                color: root.entry.letter-is-live ? Theme.text : Theme.text-muted;
                accessible-role: none;
            }

            VerticalLayout {
                alignment: center;
                width: 16px;

                Icon {
                    source: Icons.chevron-right;
                    size: 16px;
                    colour: Theme.text-muted;
                    opacity: touch.has-hover || root.selected ? 1 : 0;
                }
            }
        }
    }
}
