// The connection page (spec 7.1.1): one connection's state, what is wrong with it, and its settings,
// in place of the list. `fsm_app::ui` fills it in; this file only draws it.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, AppButton, Card, Field } from "theme.slint";
import { EntryKind, PrimaryAction, RowStatus, RowTexts, StatusIcon } from "rows.slint";

export enum LoginKind { password, key-file, agent, ask }

export struct PageView {
    kind: EntryKind,
    name: string,
    status: RowStatus,
    letter: string,
    primary: PrimaryAction,
    primary-enabled: bool,
    can-open: bool,
    can-edit: bool,
    can-delete: bool,
    // What happened, and what to do. Empty if all is well.
    problem: string,
    problem-hint: string,
    // Red if it failed, amber if it is only worth knowing.
    problem-is-error: bool,
    host: string,
    port: string,
    user: string,
    login: LoginKind,
    key-file: string,
    remote-path: string,
    // Empty for Auto.
    drive: string,
    jump-host: string,
    mount-on-start: bool,
    auto-reconnect: bool,
    read-only: bool,
    cache: string,
    keep-alive: string,
}

export component ConnectionPage {
    in property <PageView> view;
    in property <bool> interactive: true;

    callback back();
    callback primary();
    callback edit();
    callback delete();

    property <bool> is-profile: root.view.kind == EntryKind.profile;
    property <string> primary-text: RowTexts.primary(root.view.primary);
    property <string> yes: @tr("Yes");
    property <string> no: @tr("No");
    property <string> status-line: !root.is-profile ? @tr("Cannot be read")
        : root.view.status == RowStatus.mounted ? (root.view.letter != "" ? @tr("Mounted on {}", root.view.letter) : @tr("Mounted"))
        : root.view.status == RowStatus.connecting ? @tr("Connecting…")
        : root.view.status == RowStatus.unmounting ? @tr("Unmounting…")
        : root.view.status == RowStatus.error ? @tr("Failed")
        : @tr("Not mounted");

    VerticalLayout {
        padding: 16px;
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 10px;

        // The header: back, the state, the name, and what can be done now.
        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                AppButton {
                    icon: Icons.arrow-left;
                    icon-only: true;
                    icon-size: 20px;
                    text: @tr("Back");
                    enabled: root.interactive;
                    clicked => {
                        root.back();
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                StatusIcon {
                    size: 28px;
                    status: root.view.status;
                    kind: root.view.kind;
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;

                Text {
                    text: root.view.name;
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }

                Text {
                    text: root.status-line;
                    font-size: Theme.small-size;
                    color: root.view.status == RowStatus.error || !root.is-profile ? Theme.red : Theme.text-muted;
                }
            }

            if root.view.primary != PrimaryAction.none: VerticalLayout {
                alignment: center;

                AppButton {
                    text: root.primary-text;
                    primary: true;
                    enabled: root.interactive && root.view.primary-enabled;
                    accessible-label: root.primary-text + " " + root.view.name;
                    clicked => {
                        root.primary();
                    }
                }
            }
        }

        if root.view.problem != "": Rectangle {
            border-radius: Theme.radius;
            background: root.view.problem-is-error ? Theme.red-tint : Theme.amber-tint;

            HorizontalLayout {
                padding: 10px;
                spacing: 10px;

                VerticalLayout {
                    alignment: start;

                    Icon {
                        source: root.view.problem-is-error ? Icons.circle-alert : Icons.triangle-alert;
                        colour: root.view.problem-is-error ? Theme.red : Theme.amber;
                        size: 20px;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.view.problem;
                        font-size: Theme.page-size;
                        color: Theme.text;
                        font-weight: 600;
                        wrap: word-wrap;
                    }

                    if root.view.problem-hint != "": Text {
                        text: root.view.problem-hint;
                        font-size: Theme.page-size;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // As high as the card, so that the buttons come right under it, and less when it does not fit.
        if root.is-profile: ScrollView {
            vertical-stretch: 0;
            preferred-height: card.preferred-height + 2px;
            content-width: self.visible-width;
            content-height: card.preferred-height + 2px;

            card := Card {
                width: parent.width;
                height: self.preferred-height;

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 2px;
                    padding-bottom: 2px;

                    Field {
                        label: @tr("Host");
                        value: root.view.host;
                    }

                    Field {
                        label: @tr("Port");
                        value: root.view.port;
                    }

                    Field {
                        label: @tr("User");
                        value: root.view.user;
                    }

                    Field {
                        label: @tr("Authentication");
                        value: root.view.login == LoginKind.password ? @tr("Password")
                            : root.view.login == LoginKind.key-file ? @tr("Key file: {}", root.view.key-file)
                            : root.view.login == LoginKind.agent ? @tr("SSH agent")
                            : @tr("Ask each time");
                    }

                    Field {
                        label: @tr("Remote path");
                        value: root.view.remote-path;
                    }

                    Field {
                        label: @tr("Drive");
                        value: root.view.drive != "" ? root.view.drive : @tr("Auto");
                    }

                    if root.view.jump-host != "": Field {
                        label: @tr("Jump host");
                        value: root.view.jump-host;
                    }

                    Field {
                        label: @tr("Mount at start");
                        value: root.view.mount-on-start ? root.yes : root.no;
                    }

                    Field {
                        label: @tr("Reconnect");
                        value: root.view.auto-reconnect ? root.yes : root.no;
                    }

                    Field {
                        label: @tr("Read-only");
                        value: root.view.read-only ? root.yes : root.no;
                    }

                    Field {
                        label: @tr("Cache");
                        value: @tr("{} s", root.view.cache);
                    }

                    Field {
                        label: @tr("Keep-alive");
                        value: root.view.keep-alive == "0" ? @tr("Off") : @tr("{} s", root.view.keep-alive);
                        last: true;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            if root.is-profile: AppButton {
                icon: Icons.pencil;
                text: @tr("Edit");
                accessible-label: @tr("Edit {}", root.view.name);
                enabled: root.interactive && root.view.can-edit;
                clicked => {
                    root.edit();
                }
            }

            AppButton {
                icon: Icons.trash;
                text: @tr("Delete");
                danger: true;
                accessible-label: @tr("Delete {}", root.view.name);
                enabled: root.interactive && root.view.can-delete;
                clicked => {
                    root.delete();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
