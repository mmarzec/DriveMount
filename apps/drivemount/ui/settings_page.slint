// The settings page (spec 7.5): the settings of spec 3.8, one per row, and About, in place of the list.
// `drivemount_app::ui` fills it in and saves each change at once; this file only draws it.

import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, Icons, AppButton, Card } from "theme.slint";

// What the user can change. The indexes are the drop-downs' places.
export struct SettingsForm {
    start-with-windows: bool,
    close-to-tray: bool,
    // System, Light, Dark.
    theme-index: int,
    // Use another free letter, Don't mount.
    letter-index: int,
    notifications: bool,
    notification-sound: bool,
    // Error, Warning, Info, Debug.
    log-index: int,
}

export enum WinFspState { ready, too-old, missing }

// What the page shows but the user cannot change.
export struct SettingsView {
    // False when the file cannot be written, which the banner above says.
    editable: bool,
    winfsp: WinFspState,
    // "2.1.25156", or empty when missing.
    winfsp-version: string,
    // DriveMount's own.
    version: string,
    has-logs: bool,
    // Whether there is a public repository to link to.
    has-source: bool,
}

// Text that opens something, in the accent colour, reachable with Tab.
component Link {
    in property <string> text;
    in property <bool> enabled: true;

    callback clicked();

    forward-focus: scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }

        Rectangle {
            border-radius: 4px;
            border-width: scope.has-focus ? 2px : 0;
            border-color: Theme.accent;
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }

        HorizontalLayout {
            padding: 2px;
            padding-left: 3px;
            padding-right: 3px;

            Text {
                text: root.text;
                font-size: Theme.page-size;
                color: !root.enabled ? Theme.text-disabled : touch.has-hover ? Theme.accent-hover : Theme.accent;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
    }
}

// A row of the card: a label on the left and a control on the right.
component SettingRow {
    in property <string> label;
    in property <bool> last;

    VerticalLayout {
        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 12px;

            Text {
                text: root.label;
                font-size: Theme.page-size;
                color: Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-role: none;
            }

            @children
        }

        if !root.last: Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }
}

// A row with a check box across it.
component CheckRow {
    in property <bool> last;

    VerticalLayout {
        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;

            @children
        }

        if !root.last: Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }
}

component Heading inherits Text {
    font-size: Theme.small-size;
    font-weight: 600;
    color: Theme.text-muted;
}

export component SettingsPage {
    in-out property <SettingsForm> form;
    in property <SettingsView> view;
    in property <bool> interactive: true;

    callback back();
    // Something in `form` changed.
    callback changed();
    callback open-logs();
    callback download-winfsp();
    callback open-licences();
    callback open-source();
    callback open-winfsp-site();

    property <bool> editable: root.interactive && root.view.editable;

    VerticalLayout {
        padding: 16px;
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                AppButton {
                    icon: Icons.arrow-left;
                    icon-only: true;
                    icon-size: 20px;
                    text: @tr("Back");
                    enabled: root.interactive;
                    clicked => {
                        root.back();
                    }
                }
            }

            Text {
                text: @tr("Settings");
                font-size: 18px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: content.preferred-height;

            content := VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                spacing: 8px;

                Card {
                    height: self.preferred-height;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        CheckRow {
                            CheckBox {
                                text: @tr("Start with Windows");
                                checked <=> root.form.start-with-windows;
                                enabled: root.editable;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }

                        CheckRow {
                            CheckBox {
                                text: @tr("Close button hides to tray");
                                checked <=> root.form.close-to-tray;
                                enabled: root.editable;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }

                        SettingRow {
                            label: @tr("Theme");

                            ComboBox {
                                width: 200px;
                                horizontal-stretch: 0;
                                model: [@tr("System"), @tr("Light"), @tr("Dark")];
                                current-index <=> root.form.theme-index;
                                enabled: root.editable;
                                accessible-label: @tr("Theme");
                                selected => {
                                    root.changed();
                                }
                            }
                        }

                        SettingRow {
                            label: @tr("When a drive letter is in use");

                            ComboBox {
                                width: 200px;
                                horizontal-stretch: 0;
                                model: [@tr("Use another free letter"), @tr("Don't mount")];
                                current-index <=> root.form.letter-index;
                                enabled: root.editable;
                                accessible-label: @tr("When a drive letter is in use");
                                selected => {
                                    root.changed();
                                }
                            }
                        }

                        CheckRow {
                            CheckBox {
                                text: @tr("Show notifications");
                                checked <=> root.form.notifications;
                                enabled: root.editable;
                                toggled => {
                                    root.changed();
                                }
                            }

                            HorizontalLayout {
                                padding-left: 28px;

                                CheckBox {
                                    text: @tr("Notification sound");
                                    checked <=> root.form.notification-sound;
                                    enabled: root.editable && root.form.notifications;
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 28px;
                                padding-bottom: 4px;

                                Text {
                                    text: @tr("Windows' Settings → System → Notifications → DriveMount has more.");
                                    font-size: Theme.small-size;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        SettingRow {
                            label: @tr("Log level");

                            ComboBox {
                                width: 120px;
                                horizontal-stretch: 0;
                                model: [@tr("Error"), @tr("Warning"), @tr("Info"), @tr("Debug")];
                                current-index <=> root.form.log-index;
                                enabled: root.editable;
                                accessible-label: @tr("Log level");
                                selected => {
                                    root.changed();
                                }
                            }

                            AppButton {
                                icon: Icons.folder-open;
                                text: @tr("Open logs folder");
                                enabled: root.interactive && root.view.has-logs;
                                clicked => {
                                    root.open-logs();
                                }
                            }
                        }

                        SettingRow {
                            label: root.view.winfsp == WinFspState.ready ? @tr("WinFsp {} installed", root.view.winfsp-version)
                                : root.view.winfsp == WinFspState.too-old ? @tr("WinFsp {} is installed, but 2.1 or later is required to mount SSH drives", root.view.winfsp-version)
                                : @tr("WinFsp 2.1 or later is required to mount SSH drives");
                            last: true;

                            if root.view.winfsp != WinFspState.ready: VerticalLayout {
                                alignment: center;

                                AppButton {
                                    text: @tr("Download WinFsp");
                                    enabled: root.interactive;
                                    clicked => {
                                        root.download-winfsp();
                                    }
                                }
                            }
                        }
                    }
                }

                Heading {
                    text: @tr("About");
                }

                Card {
                    height: self.preferred-height;

                    VerticalLayout {
                        padding: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 6px;

                        Text {
                            text: @tr("DriveMount {}", root.view.version);
                            font-size: Theme.page-size;
                            font-weight: 600;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: @tr("Licensed under the GNU GPL v3");
                                font-size: Theme.page-size;
                                color: Theme.text;
                                vertical-alignment: center;
                            }

                            if root.view.has-source: Link {
                                text: @tr("Source code");
                                enabled: root.interactive;
                                clicked => {
                                    root.open-source();
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }

                        Text {
                            // NFR-LIC-02: WinFsp's FLOSS exception asks for these words.
                            text: "WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos";
                            font-size: Theme.page-size;
                            color: Theme.text;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            Link {
                                text: "https://github.com/winfsp/winfsp";
                                enabled: root.interactive;
                                clicked => {
                                    root.open-winfsp-site();
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            padding-top: 6px;
                            spacing: 8px;
                            alignment: start;

                            AppButton {
                                text: @tr("Third-party licences");
                                enabled: root.interactive;
                                clicked => {
                                    root.open-licences();
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Link {
                                    text: @tr("Logs folder");
                                    enabled: root.interactive && root.view.has-logs;
                                    clicked => {
                                        root.open-logs();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
