// SPDX-License-Identifier: GPL-3.0-or-later

// One line of the list: a profile, an entry of the file that cannot be read, or a network drive mapped
// outside DriveMount, which is only shown (spec 7.1, FR-SMB-09). Rust
// decides what each shows: see `drivemount_app::ui::list`. A click opens the connection page; the details a
// row has no room for are on that page and in a tooltip.

import { Theme, Icons, Icon, AppButton } from "theme.slint";

export enum EntryKind { profile, unreadable, external }
export enum RowStatus { disconnected, connecting, mounted, reconnecting, unmounting, error }
export enum PrimaryAction { none, mount, cancel, unmount, retry }

export struct ListEntry {
    kind: EntryKind,
    top: length,
    height: length,
    name: string,
    address: string,
    // "SSH" or "SMB", as the dialog names them; empty when not known, as for an external drive of another provider.
    protocol: string,
    letter: string,
    letter-is-live: bool,
    status: RowStatus,
    line: string,
    line-is-problem: bool,
    primary: PrimaryAction,
    primary-enabled: bool,
    can-open: bool,
    can-edit: bool,
    can-delete: bool,
    // An external SMB drive a profile can take the place of (FR-SMB-10).
    can-take-over: bool,
}

// What each state is called, and what its button says.
export global RowTexts {
    public pure function status(kind: EntryKind, status: RowStatus) -> string {
        return kind == EntryKind.unreadable ? @tr("cannot be read")
            : kind == EntryKind.external ? @tr("mapped outside DriveMount")
            : status == RowStatus.mounted ? @tr("mounted")
            : status == RowStatus.connecting ? @tr("connecting")
            : status == RowStatus.reconnecting ? @tr("reconnecting")
            : status == RowStatus.unmounting ? @tr("unmounting")
            : status == RowStatus.error ? @tr("failed")
            : @tr("not mounted");
    }
    public pure function primary(action: PrimaryAction) -> string {
        return action == PrimaryAction.mount ? @tr("Mount")
            : action == PrimaryAction.cancel ? @tr("Cancel")
            : action == PrimaryAction.unmount ? @tr("Unmount")
            : action == PrimaryAction.retry ? @tr("Retry")
            : "";
    }
}

// The state as an icon. Only a connecting one asks for frames: reconnecting can last for hours.
export component StatusIcon {
    in property <RowStatus> status;
    in property <EntryKind> kind: EntryKind.profile;
    in property <length> size: 20px;

    property <bool> busy: root.status == RowStatus.connecting || root.status == RowStatus.reconnecting || root.status == RowStatus.unmounting;

    width: root.size;
    height: root.size;
    accessible-role: none;

    // An external drive: filled while Windows has it connected, hollow otherwise (status `mounted`
    // or not).
    Icon {
        size: root.size;
        source: root.kind == EntryKind.external ? (root.status == RowStatus.mounted ? Icons.hard-drive-link-filled : Icons.hard-drive-link)
            : root.kind == EntryKind.unreadable ? Icons.triangle-alert
            : root.status == RowStatus.mounted ? Icons.circle-check
            : root.status == RowStatus.error ? Icons.circle-alert
            : root.busy ? Icons.loader
            : Icons.circle;
        colour: root.kind == EntryKind.external ? Theme.grey
            : root.kind == EntryKind.unreadable ? Theme.red
            : root.status == RowStatus.mounted ? Theme.green
            : root.status == RowStatus.error ? Theme.red
            : root.busy ? Theme.amber
            : Theme.grey;
        opacity: root.kind == EntryKind.external ? 1 : root.status == RowStatus.connecting ? 0.6 + 0.4 * Math.sin(360deg * animation-tick() / 1.2s) : 1;
    }
}

export component ProfileRow {
    in property <ListEntry> entry;
    in property <bool> selected;
    in property <bool> interactive: true;
    in property <int> position;
    in property <int> total;

    callback pressed();
    callback primary();
    callback open();
    callback edit();
    callback delete();
    callback copy-path();
    callback take-over();
    callback hover-changed(hovering: bool);

    property <bool> external: root.entry.kind == EntryKind.external;
    property <string> status-text: RowTexts.status(entry.kind, entry.status);
    property <string> primary-text: RowTexts.primary(entry.primary);

    accessible-role: list-item;
    accessible-label: entry.name + (entry.protocol != "" ? ", " + entry.protocol : "") + ", " + status-text
        + (entry.address != "" ? ", " + entry.address : "")
        + (entry.letter != "" ? ", " + entry.letter : "")
        + (entry.line != "" ? ", " + entry.line : "");
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-item-index: position;
    accessible-item-count: total;
    accessible-action-default => {
        root.pressed();
    }

    Rectangle {
        border-radius: Theme.radius;
        background: root.selected ? Theme.selected
            : touch.has-hover ? Theme.hover
            : transparent;
    }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => {
            root.pressed();
        }
        changed has-hover => {
            root.hover-changed(self.has-hover);
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;

        // The whole row is dimmed for an external drive, but its letter (spec 7.1).
        VerticalLayout {
            alignment: center;
            opacity: root.external ? 0.6 : 1;

            StatusIcon {
                status: root.entry.status;
                kind: root.entry.kind;
            }
        }

        Text {
            text: root.entry.name;
            preferred-width: 0;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
            color: root.external ? Theme.text-muted : Theme.text;
            accessible-role: none;
        }

        // The protocol, as a tag after the name.
        if root.entry.protocol != "": VerticalLayout {
            alignment: center;
            opacity: root.external ? 0.6 : 1;

            Rectangle {
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.text-muted;
                width: protocol-tag.preferred-width + 10px;
                height: protocol-tag.preferred-height + 2px;

                protocol-tag := Text {
                    text: root.entry.protocol;
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    accessible-role: none;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            width: 96px;

            if root.external: HorizontalLayout {
                alignment: center;

                Rectangle {
                    border-radius: 4px;
                    background: Theme.hover;
                    width: tag.preferred-width + 12px;
                    height: tag.preferred-height + 4px;

                    tag := Text {
                        text: @tr("External");
                        font-size: Theme.small-size;
                        color: Theme.text-muted;
                        accessible-role: none;
                    }
                }
            }

            if root.entry.primary != PrimaryAction.none: AppButton {
                text: root.primary-text;
                primary: root.entry.primary == PrimaryAction.retry;
                enabled: root.interactive && root.entry.primary-enabled;
                accessible-label: root.primary-text + " " + root.entry.name;
                clicked => {
                    root.primary();
                }
            }
        }

        // The letter it is on, else the one it asks for, dimmed while not on it; Auto when it
        // asks for none.
        Text {
            text: root.entry.letter != "" ? root.entry.letter
                : root.entry.kind == EntryKind.profile ? @tr("Auto")
                : "";
            width: 36px;
            vertical-alignment: center;
            horizontal-alignment: right;
            font-weight: 600;
            color: root.entry.letter-is-live ? Theme.text : Theme.text-muted;
            accessible-role: none;
        }

        VerticalLayout {
            alignment: center;
            width: 16px;

            Icon {
                source: Icons.chevron-right;
                size: 16px;
                colour: Theme.text-muted;
                opacity: touch.has-hover || root.selected ? 1 : 0;
            }
        }
    }

    // Last, so that it is on top and sees a right-click before the TouchArea, which would take
    // it: an item that grabs the mouse for any button keeps it from the items under it. With no
    // children it lets every other event through, as LineEdit's does.
    menu := ContextMenuArea {
        width: 100%;
        height: 100%;
        enabled: root.interactive;

        Menu {
            MenuItem {
                title: @tr("Details");
                activated => {
                    root.pressed();
                }
            }
            if root.entry.can-open: MenuItem {
                title: @tr("Open in Explorer");
                activated => {
                    root.open();
                }
            }
            // An external drive is removed where it was made (spec 7.1).
            if root.external: MenuItem {
                title: @tr("Copy path");
                activated => {
                    root.copy-path();
                }
            }
            // FR-SMB-10: the one thing DriveMount does to such a drive, when asked.
            if root.external && root.entry.can-take-over: MenuItem {
                title: @tr("Manage with DriveMount…");
                activated => {
                    root.take-over();
                }
            }
            if !root.external: MenuItem {
                title: @tr("Edit…");
                enabled: root.entry.can-edit;
                activated => {
                    root.edit();
                }
            }
            if !root.external: MenuItem {
                title: @tr("Delete…");
                enabled: root.entry.can-delete;
                activated => {
                    root.delete();
                }
            }
        }
    }
}
