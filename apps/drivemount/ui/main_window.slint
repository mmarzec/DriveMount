// The main window (spec 7.1), and its keys (spec 7.7). `drivemount_app::ui` holds what it means: this file
// only draws what it is given, and reports what was pressed.

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-SemiBold.ttf";

import { Palette, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, AppButton, Card } from "theme.slint";
import { EntryKind, ListEntry, PrimaryAction, ProfileRow, RowStatus } from "rows.slint";
import { LoginKind, PageView, ConnectionPage } from "connection_page.slint";
import { Texts } from "texts.slint";
import { AuthChoice, DialogForm, DialogMarks, DialogView, KeyFileBox, ProfileDialog } from "dialog.slint";
import { PromptInput, PromptKind, PromptPanel, PromptView } from "prompts.slint";
import { SettingsForm, SettingsPage, SettingsView, WinFspState } from "settings_page.slint";

export { AuthChoice, DialogForm, DialogMarks, DialogView, EntryKind, KeyFileBox, ListEntry, LoginKind, PageView, PrimaryAction, PromptInput, PromptKind, PromptView, RowStatus, SettingsForm, SettingsView, Texts, WinFspState }

export enum ThemeChoice { system, light, dark }

component Banner {
    in property <string> text;
    in property <string> button-text;
    in property <bool> interactive: true;

    callback clicked();

    accessible-role: groupbox;
    accessible-label: text;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 8px;

        Rectangle {
            border-radius: Theme.radius;
            background: Theme.amber-tint;

            HorizontalLayout {
                padding: 10px;
                padding-left: 12px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        source: Icons.triangle-alert;
                        colour: Theme.amber;
                        size: 18px;
                    }
                }

                Text {
                    text: root.text;
                    color: Theme.text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accessible-role: none;
                }

                if root.button-text != "": VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    AppButton {
                        text: root.button-text;
                        enabled: root.interactive;
                        clicked => {
                            root.clicked();
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "DriveMount";
    preferred-width: 640px;
    preferred-height: 420px;
    min-width: 480px;
    min-height: 320px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 15px;

    // The list.
    in property <[ListEntry]> entries;
    in property <length> list-height;
    in property <int> selected-index: -1;
    in property <length> selected-top;
    in property <length> selected-height;
    // Whether there is nothing to list at all.
    in property <bool> no-connections;
    in property <string> status-text;

    // The connection page, in place of the list.
    in property <bool> page-open;
    in property <PageView> page-view;

    // The settings page, in place of the list.
    in property <bool> settings-open;
    in-out property <SettingsForm> settings-form;
    in property <SettingsView> settings-view;

    // What is allowed.
    in property <bool> can-add: true;
    in property <bool> can-mount-all;
    in property <bool> can-unmount-all;

    // Banners.
    in property <bool> winfsp-missing;
    in property <string> read-only-text;
    in property <string> settings-text;
    in property <string> failure-text;
    // A crash report from the last run (FR-APP-07), with Open logs folder.
    in property <string> crash-text;

    // Asking first: the question, and the button that says yes.
    in property <string> question;
    in property <string> question-yes: @tr("Delete");

    // The profile dialog.
    in property <bool> dialog-open;
    in-out property <DialogForm> form;
    in property <DialogMarks> marks;
    in property <DialogView> dialog-view;
    in property <[string]> drive-items;
    in-out property <bool> advanced-open;

    // A prompt, in front of all that.
    in property <bool> prompt-open;
    in property <PromptView> prompt-view;
    in-out property <PromptInput> prompt-input;
    in property <bool> caps-lock;

    out property <length> list-scroll: -list.content-y;
    out property <length> list-visible-height: list.visible-height;

    callback add-pressed();
    callback mount-all-pressed();
    callback unmount-all-pressed();
    callback settings-pressed();
    callback download-winfsp-pressed();
    callback crash-logs-pressed();

    // A click on a row, which opens its page.
    callback row-pressed(index: int);
    callback row-primary(index: int);
    callback row-open(index: int);
    callback row-edit(index: int);
    callback row-delete(index: int);

    callback page-back();
    callback page-primary();
    callback page-edit();
    callback page-delete();

    callback settings-back();
    callback settings-changed();
    callback open-logs-pressed();
    callback licences-pressed();
    callback source-pressed();
    callback winfsp-site-pressed();

    callback move-selection(delta: int);
    callback activate-selected();
    callback open-selected();
    callback open-page-selected();
    callback edit-selected();
    callback delete-selected();
    callback hide-pressed();

    callback question-answered(yes: bool);

    callback form-edited();
    callback host-edited(text: string);
    callback browse-key-file(which: KeyFileBox);
    callback test-pressed();
    callback cancel-test-pressed();
    callback save-pressed();
    callback dialog-cancelled();

    callback prompt-ok();
    callback prompt-cancelled();
    callback prompt-trust-once();
    callback prompt-trust-save();
    callback prompt-open-location();
    // A key went up in a prompt, which may have been Caps Lock.
    callback caps-lock-check();
    // Something was posted from another thread.
    callback mail-arrived();

    public function set-theme(choice: ThemeChoice) {
        Palette.color-scheme = choice == ThemeChoice.dark ? ColorScheme.dark
            : choice == ThemeChoice.light ? ColorScheme.light
            : ColorScheme.unknown;
    }

    public function ensure-selected-visible() {
        if (root.selected-index < 0) {
            return;
        }
        if (root.selected-top < -list.content-y) {
            list.content-y = -root.selected-top;
        } else if (root.selected-top + root.selected-height > -list.content-y + list.visible-height) {
            list.content-y = list.visible-height - root.selected-top - root.selected-height;
        }
    }

    public function focus-list() {
        keys.focus();
    }

    // Where the keys go when a prompt closes.
    public function focus-after-prompt() {
        if (root.dialog-open) {
            root.refocus-dialog = !root.refocus-dialog;
        } else {
            keys.focus();
        }
    }

    // Flipped to send the focus into the dialog, which is only there when it is open.
    property <bool> refocus-dialog;
    property <bool> asking: root.question != "";
    property <bool> interactive: !root.asking && !root.dialog-open && !root.prompt-open;
    // No page is in the list's place.
    property <bool> showing-list: !root.page-open && !root.dialog-open && !root.settings-open;
    out property <bool> is-dark: Theme.dark;

    // The tooltip of the row under the mouse. Its timer runs only while a row is hovered and the tip
    // is not yet up, so nothing wakes up at idle (NFR-PERF-05).
    property <int> tip-index: -1;
    property <bool> tip-shown;
    property <length> tip-top;
    property <length> tip-bottom;
    property <bool> tip-wanted: root.tip-index >= 0 && root.tip-index < root.entries.length
        && root.interactive && root.showing-list;
    property <string> tip-text: !root.tip-wanted ? ""
        : root.entries[root.tip-index].address
            + (root.entries[root.tip-index].address != "" && root.entries[root.tip-index].line != "" ? "\n" : "")
            + root.entries[root.tip-index].line;

    Timer {
        interval: 700ms;
        running: root.tip-wanted && !root.tip-shown;
        triggered => {
            root.tip-shown = true;
        }
    }

    init => {
        keys.focus();
    }

    keys := FocusScope {
        // Before anything focused sees them, so that they work wherever the focus is.
        capture-key-pressed(event) => {
            if (root.prompt-open) {
                if (event.text == Key.Escape) {
                    root.prompt-cancelled();
                    return accept;
                }
                return reject;
            }
            if (root.asking) {
                if (event.text == Key.Escape) {
                    root.question-answered(false);
                    keys.focus();
                    return accept;
                }
                return reject;
            }
            if (root.dialog-open) {
                if (event.text == Key.Escape) {
                    root.dialog-cancelled();
                    return accept;
                }
                return reject;
            }
            // The page's own controls have every other key.
            if (root.settings-open) {
                if (event.text == Key.Escape) {
                    root.settings-back();
                    keys.focus();
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.Escape) {
                if (root.page-open) {
                    root.page-back();
                    keys.focus();
                } else {
                    root.hide-pressed();
                }
                return accept;
            }
            if (!root.page-open && event.text == Key.UpArrow) {
                root.move-selection(-1);
                return accept;
            }
            if (!root.page-open && event.text == Key.DownArrow) {
                root.move-selection(1);
                return accept;
            }
            if (event.modifiers.control) {
                if (event.text == "n" || event.text == "N") {
                    root.add-pressed();
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.edit-selected();
                    return accept;
                }
                if (event.text == "i" || event.text == "I") {
                    root.open-page-selected();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.open-selected();
                    return accept;
                }
            }
            return reject;
        }

        capture-key-released(event) => {
            if (root.prompt-open) {
                root.caps-lock-check();
            }
            return reject;
        }

        // What the focused control did not want, so that Enter and Space stay a focused button's.
        key-pressed(event) => {
            if (!root.interactive || root.settings-open) {
                return reject;
            }
            if (event.text == Key.Return) {
                root.activate-selected();
                return accept;
            }
            if (event.text == " " && !root.page-open) {
                root.open-page-selected();
                return accept;
            }
            if (event.text == Key.Delete) {
                root.delete-selected();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // The toolbar.
            HorizontalLayout {
                padding: 12px;
                padding-left: 16px;
                spacing: 8px;

                Text {
                    text: "DriveMount";
                    font-size: 17px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accessible-role: none;
                }

                AppButton {
                    icon: Icons.plus;
                    text: @tr("Add");
                    enabled: root.interactive && root.can-add;
                    accessible-label: @tr("Add connection");
                    clicked => {
                        root.add-pressed();
                    }
                }

                AppButton {
                    icon: Icons.play;
                    icon-size: 16px;
                    text: @tr("Mount all");
                    enabled: root.interactive && root.can-mount-all;
                    clicked => {
                        root.mount-all-pressed();
                    }
                }

                AppButton {
                    icon: Icons.square;
                    icon-size: 15px;
                    text: @tr("Unmount all");
                    enabled: root.interactive && root.can-unmount-all;
                    clicked => {
                        root.unmount-all-pressed();
                    }
                }

                AppButton {
                    icon: Icons.settings;
                    icon-only: true;
                    icon-size: 20px;
                    text: @tr("Settings");
                    enabled: root.interactive;
                    clicked => {
                        root.settings-pressed();
                    }
                }
            }

            if root.winfsp-missing: Banner {
                text: @tr("WinFsp 2.1 or later is required to mount SSH drives");
                button-text: @tr("Download WinFsp");
                interactive: root.interactive;
                clicked => {
                    root.download-winfsp-pressed();
                }
            }

            if root.read-only-text != "": Banner {
                text: root.read-only-text;
            }

            if root.settings-text != "": Banner {
                text: root.settings-text;
            }

            if root.failure-text != "": Banner {
                text: root.failure-text;
            }

            if root.crash-text != "": Banner {
                text: root.crash-text;
                button-text: @tr("Open logs folder");
                interactive: root.interactive;
                clicked => {
                    root.crash-logs-pressed();
                }
            }

            Rectangle {
                vertical-stretch: 1;

                list := ScrollView {
                    visible: root.showing-list;
                    enabled: root.interactive && root.showing-list;
                    content-width: self.visible-width;
                    content-height: root.list-height;

                    for entry[index] in root.entries: Rectangle {
                        y: entry.top;
                        x: 8px;
                        width: parent.width - 16px;
                        height: entry.height;

                        // Gone while a page is up, so that only the page's buttons can be found.
                        if root.showing-list: ProfileRow {
                            width: parent.width;
                            height: parent.height;
                            entry: entry;
                            selected: index == root.selected-index;
                            interactive: root.interactive;
                            position: index;
                            total: root.entries.length;
                            pressed => {
                                root.tip-index = -1;
                                root.tip-shown = false;
                                root.row-pressed(index);
                                keys.focus();
                            }
                            primary => {
                                root.row-primary(index);
                            }
                            open => {
                                root.row-open(index);
                            }
                            edit => {
                                root.row-edit(index);
                            }
                            delete => {
                                root.row-delete(index);
                            }
                            hover-changed(hovering) => {
                                if (hovering) {
                                    root.tip-index = index;
                                    root.tip-shown = false;
                                    root.tip-top = self.absolute-position.y;
                                    root.tip-bottom = self.absolute-position.y + self.height;
                                } else if (root.tip-index == index) {
                                    root.tip-index = -1;
                                    root.tip-shown = false;
                                }
                            }
                        }

                        // A hairline between rows.
                        if root.showing-list && index < root.entries.length - 1: Rectangle {
                            x: 8px;
                            y: parent.height - 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.border;
                        }
                    }
                }

                if root.no-connections && root.showing-list: VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: center;

                        Icon {
                            source: Icons.hard-drive;
                            size: 44px;
                            colour: Theme.text-muted;
                        }
                    }

                    Text {
                        text: @tr("No connections yet.");
                        color: Theme.text;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: @tr("Choose Add to set one up.");
                        font-size: Theme.small-size;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }

                if root.page-open && !root.dialog-open: ConnectionPage {
                    width: parent.width;
                    height: parent.height;
                    view: root.page-view;
                    interactive: root.interactive;
                    back => {
                        root.page-back();
                        keys.focus();
                    }
                    primary => {
                        root.page-primary();
                    }
                    edit => {
                        root.page-edit();
                    }
                    delete => {
                        root.page-delete();
                    }
                }

                if root.settings-open && !root.dialog-open: SettingsPage {
                    width: parent.width;
                    height: parent.height;
                    form <=> root.settings-form;
                    view: root.settings-view;
                    interactive: root.interactive;
                    back => {
                        root.settings-back();
                        keys.focus();
                    }
                    changed => {
                        root.settings-changed();
                    }
                    open-logs => {
                        root.open-logs-pressed();
                    }
                    download-winfsp => {
                        root.download-winfsp-pressed();
                    }
                    open-licences => {
                        root.licences-pressed();
                    }
                    open-source => {
                        root.source-pressed();
                    }
                    open-winfsp-site => {
                        root.winfsp-site-pressed();
                    }
                }

                if root.dialog-open: ProfileDialog {
                    property <bool> refocus: root.refocus-dialog;

                    width: parent.width;
                    height: parent.height;
                    form <=> root.form;
                    marks: root.marks;
                    view: root.dialog-view;
                    drive-items: root.drive-items;
                    advanced-open <=> root.advanced-open;
                    interactive: !root.asking && !root.prompt-open;
                    changed refocus => {
                        self.focus-again();
                    }
                    edited => {
                        root.form-edited();
                    }
                    host-edited(text) => {
                        root.host-edited(text);
                    }
                    browse(which) => {
                        root.browse-key-file(which);
                    }
                    test => {
                        root.test-pressed();
                    }
                    cancel-test => {
                        root.cancel-test-pressed();
                    }
                    save => {
                        root.save-pressed();
                    }
                    cancel => {
                        root.dialog-cancelled();
                    }
                }
            }

            Rectangle {
                height: 30px;
                background: Theme.sunken;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }

                Text {
                    x: 16px;
                    width: parent.width - 32px;
                    text: root.status-text;
                    font-size: Theme.small-size;
                    color: Theme.text-muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        if root.tip-shown && root.tip-wanted && root.tip-text != "": Rectangle {
            property <length> below: root.tip-bottom + 4px;
            property <bool> fits-below: self.below + self.height < root.height - 34px;

            x: 56px;
            y: self.fits-below ? self.below : root.tip-top - self.height - 4px;
            width: min(tip-label.preferred-width + 24px, root.width - 72px);
            height: tip-label.preferred-height + 14px;
            border-radius: 6px;
            background: Theme.dark ? #3E3D39 : #29261B;

            tip-label := Text {
                x: 12px;
                width: parent.width - 24px;
                text: root.tip-text;
                font-size: Theme.small-size;
                color: #F3F1EA;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        if root.asking: Rectangle {
            background: Theme.scrim;

            // Nothing behind it can be reached by mouse, and everything there is disabled for Tab.
            TouchArea { }

            Card {
                width: min(parent.width - 48px, 400px);
                height: panel.preferred-height;

                panel := VerticalLayout {
                    padding: 20px;
                    spacing: 18px;

                    Text {
                        text: root.question;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;

                        AppButton {
                            text: root.question-yes;
                            danger: true;
                            enabled: !root.prompt-open;
                            clicked => {
                                root.question-answered(true);
                                keys.focus();
                            }
                        }

                        // The safe answer is the one Enter gives.
                        no := AppButton {
                            text: @tr("Cancel");
                            enabled: !root.prompt-open;
                            init => {
                                self.focus();
                            }
                            clicked => {
                                root.question-answered(false);
                                keys.focus();
                            }
                        }
                    }
                }
            }
        }

        if root.prompt-open: PromptPanel {
            width: parent.width;
            height: parent.height;
            view: root.prompt-view;
            input <=> root.prompt-input;
            caps-lock: root.caps-lock;
            ok => {
                root.prompt-ok();
            }
            cancel => {
                root.prompt-cancelled();
            }
            trust-once => {
                root.prompt-trust-once();
            }
            trust-save => {
                root.prompt-trust-save();
            }
            open-location => {
                root.prompt-open-location();
            }
            browse(which) => {
                root.browse-key-file(which);
            }
        }
    }
}
