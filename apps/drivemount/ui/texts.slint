// Everything Rust has to show, as `slint` has no `tr!` for Rust code: `@tr` only exists here
// (NFR-UX-05). `drivemount_app::ui::errors` picks the function for each error.

export global Texts {
    // Spec 7.8, as "what happened" and "what to do".
    public pure function auth(user: string, host: string) -> string {
        return @tr("Authentication failed for {}@{}.", user, host);
    }
    public pure function auth-hint() -> string {
        return @tr("Check the user name and password or key.");
    }
    public pure function host-key-changed() -> string {
        return @tr("Server key has changed: connection refused.");
    }
    public pure function host-key-revoked() -> string {
        return @tr("Server key has been revoked: connection refused.");
    }
    public pure function host-key-revoked-hint(line: int) -> string {
        return @tr("known_hosts line {} marks this key as revoked. Ask the server's administrator for its current key.", line);
    }
    public pure function host-key-rejected() -> string {
        return @tr("Server key not trusted.");
    }
    public pure function host-key-rejected-hint() -> string {
        return @tr("Mount again to see the prompt.");
    }
    public pure function dns(host: string) -> string {
        return @tr("Host {} not found.", host);
    }
    public pure function dns-hint() -> string {
        return @tr("Check the host name.");
    }
    public pure function unreachable(host: string, port: int) -> string {
        return @tr("Cannot reach {}:{}.", host, port);
    }
    public pure function unreachable-hint() -> string {
        return @tr("Check the network, VPN or firewall.");
    }
    public pure function timeout(host: string) -> string {
        return @tr("{} did not respond in time.", host);
    }
    public pure function path-not-found(path: string) -> string {
        return @tr("Remote path {} not found.", path);
    }
    public pure function path-not-found-hint() -> string {
        return @tr("Edit the connection and check the remote path.");
    }
    public pure function path-not-dir(path: string) -> string {
        return @tr("Remote path {} is not a folder.", path);
    }
    public pure function sftp-unavailable() -> string {
        return @tr("The server does not provide SFTP.");
    }
    public pure function sftp-unavailable-hint() -> string {
        return @tr("Ask the administrator to enable the SFTP subsystem.");
    }
    public pure function algorithms() -> string {
        return @tr("No encryption method in common with the server.");
    }
    public pure function algorithms-hint() -> string {
        return @tr("The server may offer only outdated algorithms. Ask its administrator to update its SSH settings.");
    }
    public pure function letter-taken(letter: string) -> string {
        return @tr("Drive {} is already in use.", letter);
    }
    public pure function letter-taken-hint() -> string {
        return @tr("Choose another letter or set Drive to Auto.");
    }
    public pure function no-free-letter() -> string {
        return @tr("No free drive letter.");
    }
    public pure function winfsp-missing() -> string {
        return @tr("WinFsp 2.1 or later is required.");
    }
    public pure function key-format() -> string {
        return @tr("Unsupported key file format.");
    }
    public pure function key-format-hint() -> string {
        return @tr("Convert a PuTTY key to OpenSSH format with PuTTYgen.");
    }
    public pure function connection-lost() -> string {
        return @tr("Connection lost.");
    }
    public pure function internal() -> string {
        return @tr("Unexpected error.");
    }
    public pure function internal-hint() -> string {
        return @tr("See the log for details.");
    }

    // The second line of a row.
    public pure function letter-moved(letter: string, wanted: string) -> string {
        return @tr("{} ({} was in use)", letter, wanted);
    }
    public pure function needs-correcting() -> string {
        return @tr("This connection needs correcting. Choose Edit to see what is wrong.");
    }
    public pure function unreadable-problem(problem: string) -> string {
        return @tr("This connection could not be read: {}", problem);
    }
    public pure function unnamed() -> string {
        return @tr("Unnamed connection");
    }

    // The status bar.
    public pure function count-mounted(count: int) -> string {
        return @tr("{} mounted", count);
    }
    public pure function count-connecting(count: int) -> string {
        return @tr("{} connecting", count);
    }
    public pure function count-reconnecting(count: int) -> string {
        return @tr("{} reconnecting", count);
    }
    public pure function count-failed(count: int) -> string {
        return @tr("{} failed", count);
    }
    public pure function nothing-mounted() -> string {
        return @tr("Nothing mounted");
    }

    // The tray (spec 7.6). The tooltip has the status bar's counts, joined by commas.
    public pure function tray-tooltip(counts: string) -> string {
        return @tr("DriveMount: {}", counts);
    }
    public pure function tray-tooltip-idle() -> string {
        return @tr("DriveMount");
    }
    public pure function tray-count-separator() -> string {
        return @tr(", ");
    }
    public pure function tray-profile(name: string, letter: string) -> string {
        return @tr("{} ({})", name, letter);
    }
    public pure function tray-connecting() -> string {
        return @tr("Connecting…");
    }
    public pure function tray-reconnecting() -> string {
        return @tr("Reconnecting…");
    }
    public pure function tray-unmounting() -> string {
        return @tr("Unmounting…");
    }
    public pure function tray-failed() -> string {
        return @tr("Failed");
    }
    public pure function tray-unmount-all() -> string {
        return @tr("Unmount all");
    }
    public pure function tray-open() -> string {
        return @tr("Open DriveMount");
    }
    public pure function tray-quit() -> string {
        return @tr("Quit");
    }
    // A toast's line when the profile's own letter was taken (FR-MNT-04, FR-NOT-01).
    public pure function toast-letter-moved(letter: string, wanted: string) -> string {
        return @tr("Mounted on {} because {} was in use.", letter, wanted);
    }

    // Banners (NFR-REL-05). What to do goes with what happened.
    public pure function read-only-damaged(detail: string) -> string {
        return @tr("The configuration file is damaged, so nothing can be saved: {} Correct the file, or restore config.toml.bak, and start DriveMount again.", detail);
    }
    public pure function read-only-cannot-read(detail: string) -> string {
        return @tr("The configuration file could not be read, so nothing can be saved: {} Check the file and start DriveMount again.", detail);
    }
    public pure function read-only-newer() -> string {
        return @tr("This configuration was written by a newer DriveMount, so nothing can be saved. Install the newer version to make changes.");
    }
    public pure function read-only-migration(from: int, detail: string) -> string {
        return @tr("The configuration file could not be updated from version {}, so nothing can be saved: {} Report this, and keep the file.", from, detail);
    }
    public pure function setting-problems(problems: string) -> string {
        return @tr("Some settings were not valid, so their defaults are in use: {}", problems);
    }

    // What a row cannot say, as its state did not change.
    public pure function mount-refused(detail: string) -> string {
        return @tr("The drive could not be mounted: {}", detail);
    }
    public pure function delete-failed(detail: string) -> string {
        return @tr("The connection could not be deleted: {}", detail);
    }
    public pure function settings-not-saved(detail: string) -> string {
        return @tr("The settings could not be saved: {}", detail);
    }
    public pure function start-with-windows-failed(detail: string) -> string {
        return @tr("Start with Windows could not be changed: {}", detail);
    }
    public pure function licences-not-opened(detail: string) -> string {
        return @tr("The third-party licences could not be opened: {}", detail);
    }

    // The profile dialog (spec 7.2).
    public pure function add-connection() -> string {
        return @tr("Add connection");
    }
    public pure function edit-connection() -> string {
        return @tr("Edit connection");
    }
    public pure function drive-auto() -> string {
        return @tr("Auto");
    }
    public pure function drive-letter-free(letter: string) -> string {
        return @tr("{} (free)", letter);
    }
    public pure function saved-password-placeholder() -> string {
        return @tr("Leave empty to keep the saved one");
    }
    public pure function secret-too-long(most: int) -> string {
        return @tr("Too long to be saved: use at most {} characters", most);
    }
    public pure function testing() -> string {
        return @tr("Connecting…");
    }
    public pure function connected(milliseconds: int) -> string {
        return @tr("✓ Connected ({} ms)", milliseconds);
    }
    public pure function nothing-can-be-saved() -> string {
        return @tr("The configuration file cannot be changed, so this cannot be saved.");
    }
    public pure function fields-to-correct() -> string {
        return @tr("Correct the marked fields and save again.");
    }
    public pure function saved-without-secret() -> string {
        return @tr("The connection was saved, but its password could not be remembered.");
    }
    public pure function secret-not-removed() -> string {
        return @tr("Nothing was saved, as the saved password could not be removed.");
    }
    public pure function not-saved() -> string {
        return @tr("The connection could not be saved. See the log for details.");
    }
    public pure function unmount-to-change() -> string {
        return @tr("Unmount to change");
    }
    public pure function choose-key-file() -> string {
        return @tr("Choose a private key file");
    }

    // Prompts (spec 7.4).
    public pure function password-for(user: string, host: string) -> string {
        return @tr("Password for {}@{}", user, host);
    }
    public pure function passphrase-for(key-name: string) -> string {
        return @tr("Passphrase for {}", key-name);
    }
    public pure function login-to(user: string, host: string) -> string {
        return @tr("Log in to {}@{}", user, host);
    }
    public pure function unknown-server() -> string {
        return @tr("Unknown server");
    }
    public pure function not-connected-before(host: string, port: int) -> string {
        return @tr("DriveMount has not connected to {}:{} before.", host, port);
    }
    public pure function server-key-changed-title() -> string {
        return @tr("Server key has changed: connection refused");
    }
    public pure function host-and-port(host: string, port: int) -> string {
        return @tr("{}:{}", host, port);
    }
    public pure function known-hosts-line(file: string, line: int) -> string {
        return @tr("{} line {}", file, line);
    }
    public pure function server-key-changed-advice(line: int) -> string {
        return @tr("This can mean someone is intercepting the connection, or the server was reinstalled. If you are sure the change is expected, remove line {} from the file and connect again.", line);
    }

    // Asking first (FR-PROF-07).
    public pure function delete-question(name: string) -> string {
        return @tr("Delete \"{}\"? Its saved password is removed too.", name);
    }
    public pure function delete-mounted-question(name: string) -> string {
        return @tr("Unmount and delete \"{}\"? Its saved password is removed too.", name);
    }
    public pure function delete-yes() -> string {
        return @tr("Delete");
    }

    // Quitting with drives up (FR-APP-04).
    public pure function quit-question(drives: int) -> string {
        return @tr("Unmount {n} drive and quit?" | "Unmount {n} drives and quit?" % drives);
    }
    public pure function quit-yes() -> string {
        return @tr("Unmount and quit");
    }

    // The last run ended in a crash (FR-APP-07).
    public pure function crashed(report: string) -> string {
        return @tr("DriveMount closed unexpectedly last time. A crash report was saved as {} in the logs folder.", report);
    }
    public pure function delete-unreadable-question(name: string) -> string {
        return @tr("Remove \"{}\" from the configuration file? It could not be read, and it cannot be brought back.", name);
    }
}
